rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request from an authenticated user?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: is the user the owner of this document?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone signed in can read basic profile (for search)
      allow read: if isSignedIn();
      // Only the owner can write their own profile
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Conversations
    match /conversations/{conversationId} {
      // Only members can read the conversation metadata
      allow read: if isSignedIn() &&
        request.auth.uid in resource.data.memberIds;

      // Create: both members must be present and the creator is one of them
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == 2;

      // Update: only members
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.memberIds;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;

        allow create: if isSignedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;

        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;

        allow delete: if isSignedIn() &&
          (request.auth.uid == resource.data.senderId ||
           request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds);
      }
    }

    // Contacts / friendships
    match /contacts/{contactId} {
      allow read, write: if isSignedIn() &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.uid == request.resource.data.ownerId);
    }

    // Blocks
    match /blocks/{blockId} {
      allow read, write: if isSignedIn() &&
        request.auth.uid == resource.data.blockerId;
    }

    // Typing indicators (short-lived)
    match /typing/{conversationId} {
      allow read, write: if isSignedIn();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
